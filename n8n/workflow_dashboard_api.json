{
  "name": "Dashboard API & Approval Handler",
  "nodes": [
    {
      "name": "GET Pending Docs",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "parameters": {
        "httpMethod": "GET",
        "path": "get-pending-docs",
        "options": {}
      }
    },
    {
      "name": "Read Pending Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "parameters": {
        "operation": "getAll",
        "documentId": "13bVOkFZXLvlND-3UQLizIj__6HM0P6TytEWG8Yk702A",
        "sheetName": "DATA",
        "options": {}
      }
    },
    {
      "name": "Filter Pending",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "key": "Status",
              "operator": "equals",
              "value": "Pending"
            }
          ]
        }
      }
    },
    {
      "name": "POST Update Status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "parameters": {
        "httpMethod": "POST",
        "path": "update-doc-status",
        "options": {}
      }
    },
    {
      "name": "Action Switcher",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "parameters": {
        "rules": {
          "rules": [
            {
              "value1": "={{ $json.body.action }}",
              "value2": "approve"
            },
            {
              "value1": "={{ $json.body.action }}",
              "value2": "revise"
            }
          ]
        }
      }
    },
    {
      "name": "Update Status Approved",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "parameters": {
        "operation": "update",
        "documentId": "13bVOkFZXLvlND-3UQLizIj__6HM0P6TytEWG8Yk702A",
        "sheetName": "DATA",
        "columnToMatchOn": "File_ID",
        "valueToMatchOn": "={{ $node[\"POST Update Status\"].json.body.task_id }}",
        "fields": {
          "value": {
            "Status": "Approved"
          }
        }
      }
    },
    {
      "name": "Update Status Revision",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "parameters": {
        "operation": "update",
        "documentId": "13bVOkFZXLvlND-3UQLizIj__6HM0P6TytEWG8Yk702A",
        "sheetName": "DATA",
        "columnToMatchOn": "File_ID",
        "valueToMatchOn": "={{ $node[\"POST Update Status\"].json.body.task_id }}",
        "fields": {
          "value": {
            "Status": "Needs Revision",
            "Admin_Notes": "={{ $node[\"POST Update Status\"].json.body.admin_notes }}"
          }
        }
      }
    }
  ]
}