{
  "name": "AI Document Analyser (Drive to GSheets via Gemini)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "event": "fileCreated",
        "options": {
          "fields": [
            "id",
            "name",
            "size",
            "createdTime",
            "webViewLink",
            "mimeType"
          ]
        }
      },
      "id": "e8ea54d3-df7b-4b2a-bd1c-c76b91123456",
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        380,
        240
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": "={{ $json.id }}",
        "options": {}
      },
      "id": "a98b76c5-df7b-4b2a-bd1c-c76b91123456",
      "name": "Google Drive Download",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        580,
        240
      ]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "value1": "={{ $node[\"Google Drive Trigger\"].json.mimeType }}",
              "operation": "contains",
              "value2": "pdf"
            },
            {
              "value1": "={{ $node[\"Google Drive Trigger\"].json.mimeType }}",
              "operation": "contains",
              "value2": "image"
            }
          ]
        },
        "fallbackOutput": 2
      },
      "id": "b88b76c5-df7b-4b2a-bd1c-c76b91123456",
      "name": "Filter PDF vs Image",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        780,
        240
      ]
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "options": {
          "responseFormat": "json_object"
        },
        "prompt": "You are a professional assistant specializing in document analysis. Analyze this PDF document. Extract and return a JSON object with the following fields in Indonesian:\n1. ai_title: A concise title of the document.\n2. main_topic: A short classification/topic (2-3 words, e.g., 'Regulasi ASN', 'Laporan Keuangan', 'Teknologi Informasi').\n3. key_points: A string containing 3 to 4 major key takeaways, EXACTLY separated by a semicolon (;). Do not use bullet points or numbering in this field.\n\nStructure your response as a valid JSON object only. Example:\n{\n  \"ai_title\": \"Judul Dokumen Anda\",\n  \"main_topic\": \"Topik Utama\",\n  \"key_points\": \"Poin pertama; Poin kedua; Poin ketiga\"\n}"
      },
      "id": "c77b76c5-df7b-4b2a-bd1c-c76b91123456",
      "name": "Gemini PDF Analyser",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [
        980,
        140
      ]
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "options": {
          "responseFormat": "json_object"
        },
        "prompt": "You are a professional assistant specializing in OCR and image analysis. Analyze this image. Perform OCR and visual understanding, then return a JSON object with the following fields in Indonesian:\n1. ai_title: A concise description of the image content (e.g. 'Kuitansi Layanan AWS', 'Kondisi Gudang Sektor B').\n2. main_topic: A short classification/topic (2-3 words, e.g., 'Kuitansi & Keuangan', 'Laporan Fasilitas').\n3. key_points: A string containing 3 to 4 major key takeaways or key text extracted, EXACTLY separated by a semicolon (;). Do not use bullet points or numbering in this field.\n\nStructure your response as a valid JSON object only. Example:\n{\n  \"ai_title\": \"Deskripsi Gambar\",\n  \"main_topic\": \"Kategori Gambar\",\n  \"key_points\": \"Detail pertama; Detail kedua; Detail ketiga\"\n}"
      },
      "id": "d66b76c5-df7b-4b2a-bd1c-c76b91123456",
      "name": "Gemini Image Analyser",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [
        980,
        340
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": "YOUR_SPREADSHEET_ID_HERE",
        "sheetName": "Documents",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $node[\"Google Drive Trigger\"].json.id }}",
            "filename": "={{ $node[\"Google Drive Trigger\"].json.name }}",
            "file_type": "={{ $node[\"Google Drive Trigger\"].json.mimeType.includes('pdf') ? 'pdf' : 'image' }}",
            "file_size": "= {{ ($node[\"Google Drive Trigger\"].json.size / (1024 * 1024)).toFixed(2) }} MB",
            "created_at": "={{ $node[\"Google Drive Trigger\"].json.createdTime }}",
            "ai_title": "={{ JSON.parse($json.text).ai_title }}",
            "main_topic": "={{ JSON.parse($json.text).main_topic }}",
            "key_points": "={{ JSON.parse($json.text).key_points }}",
            "status": "Pending",
            "revision_notes": "",
            "gdrive_link": "={{ $node[\"Google Drive Trigger\"].json.webViewLink }}"
          }
        },
        "options": {}
      },
      "id": "f55b76c5-df7b-4b2a-bd1c-c76b91123456",
      "name": "Insert to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1220,
        240
      ]
    }
  ],
  "connections": {
    "Google Drive Trigger": {
      "main": [
        [
          {
            "node": "Google Drive Download",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Drive Download": {
      "main": [
        [
          {
            "node": "Filter PDF vs Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter PDF vs Image": {
      "main": [
        [
          {
            "node": "Gemini PDF Analyser",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Gemini Image Analyser",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini PDF Analyser": {
      "main": [
        [
          {
            "node": "Insert to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Image Analyser": {
      "main": [
        [
          {
            "node": "Insert to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "meta": {
    "templateId": "gemini-gdrive-analysis"
  }
}
